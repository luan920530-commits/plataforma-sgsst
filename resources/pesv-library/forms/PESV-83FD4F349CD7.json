":1}},"A86":{"v":"1.     OBJETIVO ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A87":{"s":{"b":1}},"A88":{"v":"Manejar y controlar de forma oportuna cualquier cambio que pueda afectar los procesos de la compañía tanto en sus peligros y riesgos","s":{"align":"justify"},"colspan":8,"rowspan":1},"A90":{"v":"2. ALCANCE ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A91":{"s":{"b":1}},"A92":{"v":"Este procedimiento aplica para todos los cambios de operación, sistemas de gestión y plan estrategico de seguridad vial, actividades, materiales, equipos, procedimientos, servicios y productos, que afecten la Seguridad y Salud en el Trabajo de tal manera que sean identificados y valorados determinando las acciones y controles a implementar antes de que se implementen los cambios.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A93":{"s":{"align":"left"}},"B93":{"s":{"align":"left"}},"C93":{"s":{"align":"left"}},"D93":{"s":{"align":"left"}},"E93":{"s":{"align":"left"}},"F93":{"s":{"align":"left"}},"G93":{"s":{"align":"left"}},"H93":{"s":{"align":"left"}},"A94":{"v":"3. RESPONSABILIDAD","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A95":{"v":"Gerente: Aprueba los cambios y la documentación pertinente","s":{"align":"justify"},"colspan":8,"rowspan":1},"A96":{"v":"Encargado del SG SST: Por redactar los documentos involucrados, los formatos y revisarlos; así mismo deberá consolidar la información de los cambios requeridos.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A97":{"v":"Jefes de departamento: Por solicitar los cambios, establecerlos, documentarlos e implementarlos una vez aprobados.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A98":{"v":"Nota: ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A99":{"v":"Para Cambios relacionados con infraestructura, el responsable de reportar los cambios será el encargado de infraestructura física.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A100":{"v":"Para Cambios relacionados con tecnología, el responsable de reportar los cambios será el encargado de tecnología.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A101":{"v":"Para Cambios relacionados con contratación, el responsable de reportar los cambios será el encargado de recursos humanos.","s":{"align":"left"},"colspan":8,"rowspan":1},"A102":{"s":{"align":"justify"}},"A103":{"v":"4 .DEFINICIONES ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A104":{"s":{"b":1}},"A105":{"v":"Lugar de Trabajo: Cualquier espacio físico en el que se realizan actividades relacionadas con el trabajo, bajo el control de la organización. Cuando se considera lo que constituye un lugar de trabajo, se debe tener en cuenta los efectos de la seguridad y salud ocupacional sobre el personal que, por ejemplo, se encuentra de viaje o en tránsito (por ejemplo: va en automóvil, en avión, en barco o en tren), está trabajando en las instalaciones de un cliente, o está trabajando en su propia casa.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A106":{"v":"Personal: Conjunto de individuos que trabajan en el mismo lugar de trabajo,  organismo ó empresa.","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A107":{"v":"Sistemas de Gestión SGSST: Parte del sistema de gestión de una Organización, empleada para desarrollar e implementar su política de seguridad industrial y salud ocupacional y gestionar sus riesgos","s":{"align":"justify"},"colspan":8,"rowspan":1},"A108":{"v":"Modificaciones: Cambiar o variar en sus caracteres no esenciales una actividad o un proceso. Introducción de cambios que se consideren necesarios en cuanto a fondo y a la forma de un documento. ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A109":{"v":"Actividades: Conjunto de tareas o acciones que se hacen con un fin determinado o son propias de una persona, una profesión o una entidad.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A110":{"v":"Materiales y Equipos: Conjunto de máquinas, herramientas u objetos de cualquier clase, necesarios para el desempeño de un servicio o el ejercicio de una profesión.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A111":{"v":"Contratistas: Persona o empresa que presta servicios a la compañía, tales como automóviles, helicópteros, lanchas, catering, plantas de tratamiento de aguas entre otras","s":{"align":"justify"},"colspan":8,"rowspan":1},"A112":{"v":"Proveedor: productor, distribuidor, minorista o vendedor de un producto, o prestador de un servicio o información. Un proveedor puede ser interno o externo a la organización. En una situación contractual un proveedor puede denominarse \"contratista\".","s":{"align":"justify"},"colspan":8,"rowspan":1},"A113":{"v":"Proceso: conjunto de actividades mutuamente relacionadas o que interactúan, las cuales transforman elementos de entrada en resultados.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A114":{"v":"Proyecto: proceso único consistente en un conjunto de actividades coordinadas y controladas con fechas de inicio y de finalización, llevadas a cabo para lograr un objetivo conforme con requisitos específicos, incluyendo las limitaciones de tiempo, costo y recursos.´","s":{"align":"justify"},"colspan":8,"rowspan":1},"A115":{"v":"Procedimiento: forma especificada para llevar a cabo una actividad o un proceso","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A116":{"v":"Documento: Información y sus medios de soporte.","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A118":{"v":"5. PROCEDIMIENTO  ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A119":{"s":{"b":1,"align":"left"}},"B119":{"s":{"b":1,"align":"left"}},"C119":{"s":{"b":1,"align":"left"}},"D119":{"s":{"b":1,"align":"left"}},"E119":{"s":{"b":1,"align":"left"}},"F119":{"s":{"b":1,"align":"left"}},"G119":{"s":{"b":1,"align":"left"}},"H119":{"s":{"b":1,"align":"left"}},"A120":{"v":"5.1 Identificación","s":{"align":"left"},"colspan":8,"rowspan":1},"A121":{"s":{"align":"left"}},"A122":{"v":"Se identificarán con base a criterios como generación de nuevos procesos, identificación de nuevos requisitos legales, nuevos contratistas, proveedores, productos, maquinaria, tecnología, insumos, estructura organizacional, nuevos proyectos y licitaciones. Los responsables de esta identificación serán entre otros Gerencias, Directores de área","s":{"align":"justify"},"colspan":8,"rowspan":1},"A124":{"v":"Descripción de los tipos de cambios: ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A125":{"v":"Infraestructura: Cambios en instalaciones (construcción de instalaciones, adecuaciones de oficinas, modificaciones a estas estructuras, zonas de almacenamiento de materiales),","s":{"align":"justify"},"colspan":8,"rowspan":1},"A126":{"v":"Requisitos legales o contractuales: se generan a partir de la identificación, seguimiento y verificación de cumplimiento de requisitos legales y/o de contratos que suscriba la organización. ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A127":{"v":"Cambios de personal, contratistas, proveedores: cuando se puedan presentar cambios significativos en cargos de personal tanto directo como contratistas y proveedores nuevos que su desempeño afecte notoriamente el sistema, para lo cual se regirán por el proceso de Recursos humanos para personal vinculado a la compañía y Compras para selección de proveedores y contratistas.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A128":{"v":"Creación de nuevos procesos, cambios en actividades, materiales e insumos: (Cuando por el cambio de la actividad económica de la empresa o ampliación en el alcance de la prestación de servicios se requiera implementar nuevos procesos o generar cambios en los mismos.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A129":{"v":"Sistema de Gestión: Cuando como consecuencia de los resultados de la revisión del sistema tanto en aspectos positivos como negativos y/o seguimiento al desempeño del mismo se requieran implementar cambios a nivel general. ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A130":{"v":"Plan estrategico de seguridad vial: Nuevas rutas, nuevas tecnologias, nueva legislación en temas relacionados con seguridad vial, nuevos clientes, nuevos productos transportados, nuevos servicios.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A131":{"s":{"align":"justify"}},"A132":{"v":"5.2  Manejo ","s":{"align":"left"},"colspan":8,"rowspan":1},"A134":{"v":"Cuando se genere un cambio en cualquiera de las estructuras, equipos o procesos, los responsables de identificar los cambios deben diligenciar el formato de planificación de cambios, el cual deberá ser enviado vía mail o entregado físicamente el encargado del SG SST en Bogotá, para ser estudiado y aprobado conjuntamente con la Gerencia.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A135":{"s":{"align":"justify"}},"A136":{"v":"Una vez sea aceptado y aprobado, se ejecutará el proceso de la gestión del cambio.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A137":{"v":"Ninguna gestión de proceso de cambio se puede realizar si no es aprobada y revisada por la Gerencia y el encargado del SG SST.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A138":{"s":{"align":"justify"}},"A139":{"v":"Los cambios se realizarán mediante la identificación, evaluación y control de los peligros y minimización de los impactos que se generen y se aplicarán el nivel de controles de eliminación, sustitución, controles de Ingeniería, precauciones y/o controles de administración y equipo de protección personal, estos serán cargados en la Matriz de Planificación del Cambio por el encargado del SG SST, quien será el responsable de consolidar la información y realizar el respectivo seguimiento.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A141":{"v":"La forma de aplicar controles para manejar el riesgo o minimizar los impactos al ambiente variará de acuerdo a los cambios que se generen, según la norma. ","s":{"align":"left"},"colspan":8,"rowspan":1},"A143":{"v":"·         Eliminación: modificar un diseño, operación o equipo para eliminar el peligro, por ejemplo, introducir dispositivos mecánicos de alzamiento para eliminar el peligro de manipulación manual. ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A144":{"v":"·         Sustitución: sustituir por un material menos peligroso o reducir la energía del sistema (por ejemplo, reducir la fuerza, el amperaje, la presión, la temperatura, etc.).","s":{"align":"justify"},"colspan":8,"rowspan":1},"A145":{"v":"·         Controles de ingeniería: instalar sistemas de ventilación, protección para las máquinas, enclavamiento, cerramientos acústicos, etc.","s":{"align":"left"},"colspan":8,"rowspan":1},"A146":{"v":"·         Señalización, advertencias, y/o controles administrativos: instalación de alarmas, procedimientos de seguridad, inspecciones de los equipos, controles de acceso.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A147":{"v":"·         Equipos de protección personal: gafas de seguridad, protección auditiva, máscaras faciales, arneses de seguridad y cuerdas, respiradores y guantes.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A149":{"v":" 5.3. Proceso general ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A151":{"v":"De acuerdo al tipo de cambio correspondiente a las operaciones de la compañía, el responsable de la identificación debe seguir los siguientes parámetros:","s":{"align":"justify"},"colspan":8,"rowspan":1},"A152":{"v":"1.    Cambios en instalaciones, sea construcción de locaciones (oficinas, modificaciones a estas estructuras), construcción de helipuertos, zonas de almacenamiento de materiales peligrosos (explosivos, gases, combustibles, aceites, productos alcalinos y productos ácidos entre otros).","s":{"align":"justify"},"colspan":8,"rowspan":1},"A153":{"v":"a.    Utilice el formato planificación de cambios","s":{"align":"justify"},"colspan":8,"rowspan":1},"A154":{"s":{"align":"justify"}},"A155":{"v":"b.    Utilice la matriz de identificación de peligros de acuerdo al cambio que se va a generar.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A157":{"v":"2. Cambios en proveedores, contratistas (vehículos), equipos especiales para medición, (estudios especiales de higiene), modificaciones en los contratos operacionales. (Por ejemplo implementación de un proceso no contemplado en el contrato original como cualquiera de los anteriores). ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A158":{"v":"a. Utilice el formato planificación de cambios.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A160":{"v":"Envíe su propuesta con los cambios sugeridos o el borrador de los procedimientos nuevos a implementar para que sean revisados y aprobados por la Gerencia y el encargado del SG SST.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A161":{"v":"3. Cambios en la utilización de sustancias y materiales peligrosos, como: ACPM, Gasolina, Aceites de motor etc.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A162":{"v":"a. Utilice el formato planificación de cambios.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A164":{"v":"4. Cambios en personal.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A165":{"v":"a. A todo el personal nuevo debe realizarse inducción al SG SST, incluyendo operaciones propias a realizar y evaluar su entendimiento.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A167":{"v":"5.4. Revisión y aprobación de los documentos, actualización de las matrices de riesgos de salud y seguridad en el trabajo. ","s":{"b":1,"align":"left"},"colspan":8,"rowspan":1},"A170":{"v":"De acuerdo al cambio que se establezca; hacer la evaluación de si los controles existentes son suficientes ó si se requieren otros controles.","s":{"align":"justify"},"colspan":8,"rowspan":1},"A171":{"s":{"align":"justify"}},"A172":{"v":"a.    Utilice el documento Procedimiento para identificación de peligros, valoración de riesgos y determinación de los controles, ","s":{"align":"justify"},"colspan":8,"rowspan":1},"A173":{"s":{"align":"justify"}},"A174":{"v":"Divulgar l