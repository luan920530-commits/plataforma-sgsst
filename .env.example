# Copia este archivo como .env (nunca lo versiones) y ajusta los valores.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/ppprae/public
APP_TIMEZONE=America/Bogota

# Solo para la primera instalación con setup.php
SETUP_TOKEN=cambia-este-token-largo-y-aleatorio
ADMIN_EMAIL=admin@ppprae.local
# ADMIN_PASSWORD=   # si se omite, setup.php genera una y la muestra una sola vez
